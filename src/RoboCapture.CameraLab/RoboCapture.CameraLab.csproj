<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\RoboCapture.Core\RoboCapture.Core.csproj" />
    <ProjectReference Include="..\RoboCapture.Persistence\RoboCapture.Persistence.csproj" />
    <ProjectReference Include="..\RoboCapture.NikonAdapter\RoboCapture.NikonAdapter.csproj" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RoboCapture.Vision\RoboCapture.Vision.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../vendor-sdks/nikon/modules/**/*.dll;../../vendor-sdks/nikon/modules/**/*.md3;../../vendor-sdks/nikon/modules/**/*.config">
      <Link>vendor-sdks/nikon/modules/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
