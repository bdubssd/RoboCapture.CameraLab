<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\RoboCapture.Core\RoboCapture.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Local proprietary profiles embedded at build time; not committed. -->
    <EmbeddedResource Include="../../vendor-sdks/nikon/modules/z-unified/*.config">
      <LogicalName>NikonProfiles.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
